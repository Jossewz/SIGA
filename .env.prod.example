# ==============================================================================
# SIGA - IEACI: Configuración de Producción (.env)
# ==============================================================================

# --- Dominio y URL Pública ---
# Si tienes un dominio o el DNS de Azure (ej. siga-ieaci.westus2.cloudapp.azure.com),
# colócalo aquí y Caddy generará automáticamente un certificado SSL gratuito (HTTPS).
# Si solo usas la IP pública por ahora, déjalo como :80
APP_DOMAIN=:80
APP_BASE_URL=http://localhost

# --- Base de Datos PostgreSQL ---
POSTGRES_DB=siga
POSTGRES_USER=siga_admin
POSTGRES_PASSWORD=DefinirPasswordSeguroPostgres2026!

# --- Almacenamiento MinIO ---
MINIO_ROOT_USER=siga_storage_admin
MINIO_ROOT_PASSWORD=DefinirPasswordSeguroMinio2026!
MINIO_BUCKET=siga

# --- Seguridad ---
APP_REMEMBER_ME_KEY=GenerarClaveAleatoriaLargaParaSesiones2026

# --- Seeder Institucional Masivo ---
# Para poblar la base de datos la primera vez con los 800+ estudiantes, docentes, etc.
# Cambiar a true en el primer arranque, y volver a false después.
SIGA_SEED_ENABLED=true

# --- IA y Analítica (Opcionales) ---
GROQ_API_KEY=
SIGA_POWERBI_URL=https://app.powerbi.com/view?r=eyJrIjoiMGU5YTlmZWQtZTUyMy00MjBjLTkzYmEtMmNmOTI4YjI0N2NlIiwidCI6IjlkMTJiZjNmLWU0ZjYtNDdhYi05MTJmLTFhMmYwZmM0OGFhNCIsImMiOjR9
