# ==============================================================================
# SIGA-IEA — Variables de Entorno de Ejemplo (SIN CREDENCIALES REALES)
# Copie este archivo a `.env` y complete los valores según su entorno local.
# ==============================================================================

# --- Servidor Web ---
SERVER_PORT=8080
APP_BASE_URL=http://localhost:8080

# --- Base de Datos PostgreSQL 16 ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/siga
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_DB_PASSWORD
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# --- Almacenamiento de Objetos MinIO (S3 API) ---
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=siga

# --- Seguridad y Sesiones ---
APP_REMEMBER_ME_KEY=CHANGE_ME_RANDOM_SECRET_KEY

# --- Correo Electrónico Institucional (SMTP) ---
APP_MAIL_ENABLED=false
APP_MAIL_FROM=no-reply@ieaci.edu.co
APP_MAIL_FROM_NAME=SIGA - IEACI Institucional
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true

# --- Asistente Escolar Inteligente "Mangle" (LLM Ruta Dual) ---
# Dejar vacío para operar con Ollama Local o el Motor Determinista Zero-Failure
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
