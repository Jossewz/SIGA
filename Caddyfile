    # Opciones globales de Caddy
    # Descomenta y define tu email si deseas alertas de expiración de Let's Encrypt
    # email admin@ieaci.edu.co
}

{$APP_DOMAIN::80} {
    encode zstd gzip

    # Proxy inverso transparente hacia el backend Spring Boot
    reverse_proxy app:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Port {server_port}
    }
}
